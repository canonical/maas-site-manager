{
  "name": "maas-site-manager",
  "type": "module",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "predev": "yarn run download-map-assets",
    "dev": "vite",
    "prebuild": "yarn run download-map-assets",
    "download-map-assets": "chmod +x ./scripts/download-map-assets.sh && ./scripts/download-map-assets.sh",
    "build": "tsc && vite build",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "cypress-open": "yarn cypress open",
    "cypress-run": "yarn cypress run",
    "generate-api-client": "openapi-ts",
    "preview": "vite preview",
    "lint": "npmPkgJsonLint . && tsc && eslint . && stylelint src/**/*.scss",
    "lint-fix": "npmPkgJsonLint . && tsc && eslint . --fix && stylelint src/**/*.scss --fix",
    "postinstall": "node ./scripts/patch-msw-worker.mjs",
    "upgrade-all": "yarn-upgrade-all -E"
  },
  "dependencies": {
    "@canonical/ds-assets": "0.45.0",
    "@canonical/maas-react-components": "2.9.1",
    "@canonical/react-components": "4.16.0",
    "@canonical/react-ds-global": "0.45.0",
    "@canonical/react-ds-global-form": "0.45.0",
    "@canonical/styles": "0.45.0",
    "@hey-api/client-axios": "0.9.1",
    "@sentry/browser": "11.10.0",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-table": "8.21.3",
    "axios": "1.21.0",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "formik": "2.4.9",
    "human-interval": "2.0.1",
    "lodash": "4.18.1",
    "maplibre-gl": "5.11.0",
    "pluralize": "8.0.0",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.1.4",
    "react-error-boundary": "6.1.6",
    "react-router": "8.5.1",
    "use-local-storage-state": "20.0.0",
    "vanilla-framework": "4.61.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@canonical/summon": "0.44.0",
    "@canonical/summon-application": "0.44.0",
    "@canonical/summon-component": "0.44.0",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@remix-run/web-fetch": "4.4.2",
    "@tanstack/eslint-plugin-query": "5.105.3",
    "@testing-library/cypress": "10.1.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/chance": "1.1.8",
    "@types/lodash": "4.17.27",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-istanbul": "5.1.0",
    "abort-controller": "3.0.0",
    "autoprefixer": "10.6.2",
    "chance": "1.1.13",
    "cypress": "16.2.1",
    "cypress-axe": "1.7.0",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "fishery": "2.4.0",
    "i18n-iso-countries": "7.14.0",
    "jsdom": "30.1.3",
    "jsdom-testing-mocks": "1.16.0",
    "mockdate": "3.0.5",
    "msw": "3.0.3",
    "npm-package-json-lint": "11.0.1",
    "prettier": "3.9.10",
    "sass-embedded": "1.107.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "timezone-mock": "1.4.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "unique-names-generator": "4.7.1",
    "unplugin-auto-import": "21.1.0",
    "vite": "8.3.5",
    "vite-plugin-stylelint": "6.3.0",
    "vitest": "5.1.0",
    "vitest-canvas-mock": "1.2.0",
    "vitest-webgl-canvas-mock": "1.1.0",
    "yarn-upgrade-all": "0.8.1"
  },
  "resolutions": {
    "strip-ansi": "^7.1.2",
    "string-width": "8.1.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "npmpackagejsonlint": {
    "rules": {
      "prefer-absolute-version-dependencies": "error",
      "prefer-absolute-version-devDependencies": "error",
      "prefer-alphabetical-dependencies": "error",
      "prefer-alphabetical-devDependencies": "error"
    }
  },
  "browserslist": [
    "last 1 chrome version",
    "last 1 firefox version",
    "last 1 safari version"
  ],
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  }
}
